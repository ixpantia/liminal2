Package: liminal2
Title: Estimate the size of the liminal space between business ask and data solution
Version: 0.2.0
Authors@R:
  c(person(given = "ixpantia, SRL",
          role = "cph",
          email = "hola@ixpantia.com"),
  person(given = "Frans",
          family = "van Dunné",
